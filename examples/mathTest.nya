import fn puts(str: [u8]) -> i32;

fn test() -> i32 {
    const: i32 pog = 5;
    return pog;
}

fn main() -> i32 {
    const: i32 num = 5 + 3 * 7;
    const: i32 num2 = test();
    if (num2 == test())
        puts("Hello World!");

    if (num2 == 0)
        puts("Shouldn't print");

    return num;
}
